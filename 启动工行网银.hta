<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="IE=11">
  <title>银行采集助手</title>
  <hta:application
    applicationname="银行采集助手"
    border="thin"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
  />
  <style>
    body {
      margin: 0;
      font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
      background: #f6f7f9;
      color: #20242a;
    }

    .app {
      width: 760px;
      padding: 22px 24px;
      box-sizing: border-box;
    }

    .header {
      margin-bottom: 16px;
      overflow: hidden;
    }

    h1 {
      margin: 0;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0;
      float: left;
    }

    .header button {
      float: right;
    }

    label {
      display: block;
      margin: 10px 0 6px;
      font-size: 13px;
      color: #4a5564;
    }

    select,
    input {
      height: 34px;
      box-sizing: border-box;
      border: 1px solid #cbd3df;
      border-radius: 5px;
      background: #fff;
      font-size: 14px;
      color: #20242a;
      padding: 0 8px;
    }

    select {
      width: 100%;
    }

    input {
      width: 100%;
    }

    button {
      height: 34px;
      border: 0;
      border-radius: 5px;
      background: #d71920;
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      cursor: hand;
      padding: 0 12px;
      white-space: nowrap;
    }

    button.secondary {
      background: #404a57;
    }

    button.ghost {
      background: #eef1f5;
      color: #27313f;
      border: 1px solid #cbd3df;
    }

    button:disabled {
      background: #a9afb8;
      cursor: default;
    }

    .editor {
      padding: 12px;
      background: #fff;
      border: 1px solid #e0e5ec;
      border-radius: 6px;
      margin-bottom: 14px;
    }

    .field {
      display: inline-block;
      width: 132px;
      margin-right: 8px;
      vertical-align: bottom;
    }

    .field.bank {
      width: 160px;
    }

    .field.task {
      width: 160px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border: 1px solid #e0e5ec;
      border-radius: 6px;
      overflow: hidden;
    }

    th,
    td {
      padding: 9px 10px;
      border-bottom: 1px solid #edf0f4;
      font-size: 13px;
      text-align: left;
      vertical-align: middle;
    }

    th {
      color: #4a5564;
      background: #f1f3f6;
      font-weight: 600;
    }

    tr:last-child td {
      border-bottom: 0;
    }

    #status {
      margin-top: 14px;
      min-height: 38px;
      font-size: 13px;
      line-height: 1.5;
      color: #5b6573;
    }
  </style>
  <script language="javascript">
    var baseDir = "C:\\Users\\ASUS ZenBook\\Documents\\New project";
    var configPath = baseDir + "\\banks.json";
    var accountsPath = baseDir + "\\accounts.json";
    var edgePath = "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe";
    var focusScript = baseDir + "\\focus-account.ps1";
    var agentScript = baseDir + "\\bank-agent.ps1";
    var logPath = baseDir + "\\bank-agent.log";
    var config = null;
    var accountStore = null;
    var editingAccountId = "";

    function shell() {
      return new ActiveXObject("WScript.Shell");
    }

    function fso() {
      return new ActiveXObject("Scripting.FileSystemObject");
    }

    function setStatus(text) {
      document.getElementById("status").innerText = text;
    }

    function log(text) {
      try {
        var file = fso().OpenTextFile(logPath, 8, true);
        var now = new Date();
        file.WriteLine("[" + now.toLocaleString() + "." + ("00" + now.getMilliseconds()).slice(-3) + "] [hta] " + text);
        file.Close();
      } catch (ignored) {
      }
    }

    function readText(path) {
      var stream = new ActiveXObject("ADODB.Stream");
      stream.Type = 2;
      stream.Charset = "utf-8";
      stream.Open();
      stream.LoadFromFile(path);
      var text = stream.ReadText();
      stream.Close();
      return text;
    }

    function writeText(path, text) {
      var stream = new ActiveXObject("ADODB.Stream");
      stream.Type = 2;
      stream.Charset = "utf-8";
      stream.Open();
      stream.WriteText(text);
      stream.SaveToFile(path, 2);
      stream.Close();
    }

    function parseJson(text) {
      if (typeof JSON !== "undefined" && JSON.parse) {
        return JSON.parse(text);
      }

      return eval("(" + text + ")");
    }

    function stringifyJson(value) {
      if (typeof JSON !== "undefined" && JSON.stringify) {
        return JSON.stringify(value, null, 2);
      }

      return toJson(value, 0);
    }

    function quoteJson(value) {
      return '"' + String(value).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\r/g, "\\r").replace(/\n/g, "\\n") + '"';
    }

    function toJson(value, level) {
      var indent = new Array(level + 1).join("  ");
      var next = new Array(level + 2).join("  ");

      if (value === null) return "null";
      if (typeof value === "string") return quoteJson(value);
      if (typeof value === "number" || typeof value === "boolean") return String(value);
      if (value instanceof Array) {
        var items = [];
        for (var i = 0; i < value.length; i++) items.push(next + toJson(value[i], level + 1));
        return "[\n" + items.join(",\n") + "\n" + indent + "]";
      }

      var parts = [];
      for (var key in value) {
        if (value.hasOwnProperty(key)) parts.push(next + quoteJson(key) + ": " + toJson(value[key], level + 1));
      }
      return "{\n" + parts.join(",\n") + "\n" + indent + "}";
    }

    function bankById(bankId) {
      for (var i = 0; i < config.banks.length; i++) {
        if (config.banks[i].id === bankId) return config.banks[i];
      }
      return null;
    }

    function taskById(bank, taskId) {
      for (var i = 0; i < bank.tasks.length; i++) {
        if (bank.tasks[i].id === taskId) return bank.tasks[i];
      }
      return bank.tasks.length ? bank.tasks[0] : null;
    }

    function accountById(accountId) {
      for (var i = 0; i < accountStore.accounts.length; i++) {
        if (accountStore.accounts[i].id === accountId) return accountStore.accounts[i];
      }
      return null;
    }

    function loadAll() {
      config = parseJson(readText(configPath));
      accountStore = parseJson(readText(accountsPath));
      fillEditorSelects();
      renderAccounts();
      setStatus("添加账户时只填写名称和卡号后四位。登录凭据不会保存。");
    }

    function fillEditorSelects() {
      var bankSelect = document.getElementById("editorBank");
      bankSelect.options.length = 0;

      for (var i = 0; i < config.banks.length; i++) {
        bankSelect.options.add(new Option(config.banks[i].name, config.banks[i].id));
      }

      fillTaskSelect();
    }

    function fillTaskSelect() {
      var bank = bankById(document.getElementById("editorBank").value);
      var taskSelect = document.getElementById("editorTask");
      taskSelect.options.length = 0;

      if (!bank) return;
      for (var i = 0; i < bank.tasks.length; i++) {
        taskSelect.options.add(new Option(bank.tasks[i].name, bank.tasks[i].id));
      }
    }

    function renderAccounts() {
      var tbody = document.getElementById("accountRows");
      tbody.innerHTML = "";

      for (var i = 0; i < accountStore.accounts.length; i++) {
        var account = accountStore.accounts[i];
        var bank = bankById(account.bankId);
        var task = bank ? taskById(bank, account.defaultTaskId) : null;
        var row = tbody.insertRow(-1);

        row.insertCell(-1).innerText = account.label || "(未命名)";
        row.insertCell(-1).innerText = bank ? bank.name : account.bankId;
        row.insertCell(-1).innerText = account.last4 ? "**** " + account.last4 : "(未填)";
        row.insertCell(-1).innerText = task ? task.name : account.defaultTaskId;

        var actions = row.insertCell(-1);
        actions.innerHTML =
          '<button onclick="startAccount(\'' + account.id + '\')">启动页面</button> ' +
          '<button class="secondary" onclick="runAccountTask(\'' + account.id + '\')">开始采集</button> ' +
          '<button class="ghost" onclick="editAccount(\'' + account.id + '\')">编辑</button> ' +
          '<button class="ghost" onclick="deleteAccount(\'' + account.id + '\')">删除</button>';
      }
    }

    function saveAccounts() {
      writeText(accountsPath, stringifyJson(accountStore));
      renderAccounts();
    }

    function resetEditor() {
      editingAccountId = "";
      document.getElementById("editorLabel").value = "";
      document.getElementById("editorLast4").value = "";
      document.getElementById("saveButton").innerText = "添加账户";
      if (config.banks.length) {
        document.getElementById("editorBank").value = config.defaultBankId || config.banks[0].id;
        fillTaskSelect();
      }
    }

    function saveEditorAccount() {
      var label = document.getElementById("editorLabel").value;
      var bankId = document.getElementById("editorBank").value;
      var last4 = document.getElementById("editorLast4").value.replace(/\D/g, "");
      var taskId = document.getElementById("editorTask").value;

      if (!label) {
        setStatus("请填写账户名称。");
        return;
      }

      if (last4 && last4.length !== 4) {
        setStatus("卡号后四位应为 4 位数字；也可以先留空。");
        return;
      }

      var account = editingAccountId ? accountById(editingAccountId) : null;
      if (!account) {
        account = {
          id: "acct-" + (new Date().getTime()),
          bankId: bankId,
          label: label,
          last4: last4,
          defaultTaskId: taskId
        };
        accountStore.accounts.push(account);
      } else {
        account.bankId = bankId;
        account.label = label;
        account.last4 = last4;
        account.defaultTaskId = taskId;
      }

      saveAccounts();
      resetEditor();
      setStatus("账户已保存。");
    }

    function editAccount(accountId) {
      var account = accountById(accountId);
      if (!account) return;

      editingAccountId = accountId;
      document.getElementById("editorLabel").value = account.label || "";
      document.getElementById("editorBank").value = account.bankId;
      fillTaskSelect();
      document.getElementById("editorLast4").value = account.last4 || "";
      document.getElementById("editorTask").value = account.defaultTaskId;
      document.getElementById("saveButton").innerText = "保存修改";
      setStatus("正在编辑：" + account.label);
    }

    function deleteAccount(accountId) {
      var account = accountById(accountId);
      if (!account) return;
      if (!confirm("删除账户：" + account.label + "？")) return;

      var next = [];
      for (var i = 0; i < accountStore.accounts.length; i++) {
        if (accountStore.accounts[i].id !== accountId) next.push(accountStore.accounts[i]);
      }
      accountStore.accounts = next;
      saveAccounts();
      resetEditor();
      setStatus("账户已删除。");
    }

    function activateEdge(appShell, bank) {
      var activated = false;
      var titles = [bank.name, "ICBC", "Microsoft Edge"];

      for (var i = 0; i < titles.length; i++) {
        if (appShell.AppActivate(titles[i])) {
          activated = true;
          log("Activated window by title: " + titles[i]);
          break;
        }
      }

      if (!activated) {
        log("Fallback AppActivate(msedge): " + appShell.AppActivate("msedge"));
      }
    }

    function startAccount(accountId) {
      var account = accountById(accountId);
      var bank = bankById(account.bankId);
      if (!bank) {
        setStatus("找不到银行配置：" + account.bankId);
        return;
      }

      setStatus("正在启动 " + account.label + " 的银行页面...");

      try {
        var appShell = shell();
        var profileDir = baseDir + "\\" + bank.profileDir;
        var port = bank.debugPort || 9222;
        var args = '"' + edgePath + '" --remote-debugging-port=' + port + ' --user-data-dir="' + profileDir + '" "' + bank.startUrl + '"';

        log("Start account. AccountId=" + account.id + " Bank=" + bank.id + " Url=" + bank.startUrl);
        appShell.Run(args, 1, false);

        window.setTimeout(function () {
          activateEdge(appShell, bank);
          window.setTimeout(function () {
            log("Sending F11.");
            appShell.SendKeys("{F11}");

            if (bank.focus && bank.focus.enabled) {
              setStatus("已发送 F11，正在聚焦" + bank.focus.label + "...");
              window.setTimeout(function () {
                var focusArgs = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + focusScript + '" -XRatio ' + bank.focus.xRatio + ' -YRatio ' + bank.focus.yRatio;
                log("Running focus script: " + focusArgs);
                appShell.Run(focusArgs, 0, false);
                setStatus("已打开页面。请手动完成登录，之后点击该账户的开始采集。");
              }, 2200);
            } else {
              setStatus("已打开页面。请手动完成登录，之后点击该账户的开始采集。");
            }
          }, 500);
        }, 3500);
      } catch (e) {
        log("Start error: " + e.message);
        setStatus("启动失败：" + e.message);
      }
    }

    function runAccountTask(accountId) {
      var account = accountById(accountId);
      var bank = bankById(account.bankId);
      var task = bank ? taskById(bank, account.defaultTaskId) : null;

      if (!bank || !task) {
        setStatus("账户配置不完整，无法采集。");
        return;
      }

      setStatus("正在采集：" + account.label + " / " + task.name);

      try {
        var appShell = shell();
        var command =
          'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + agentScript + '"' +
          ' -BankId "' + bank.id + '"' +
          ' -TaskId "' + task.id + '"' +
          ' -AccountId "' + account.id + '"' +
          ' -AccountLabel "' + account.label + '"' +
          ' -AccountLast4 "' + (account.last4 || "") + '"';

        log("Run account task. " + command);
        var exitCode = appShell.Run(command, 0, true);
        log("Task exited with code: " + exitCode);

        if (exitCode === 0) {
          setStatus("采集完成。输出前缀：" + task.outputPrefix + "（csv/json/txt）。");
        } else {
          setStatus("采集失败。请查看 bank-agent.log，退出码 " + exitCode + "。");
        }
      } catch (e) {
        log("Task error: " + e.message);
        setStatus("采集失败：" + e.message);
      }
    }

    window.onload = function () {
      window.resizeTo(820, 560);
      window.moveTo((screen.width - 820) / 2, (screen.height - 560) / 2);
      loadAll();
    };
  </script>
</head>
<body>
  <div class="app">
    <div class="header">
      <h1>银行采集助手</h1>
      <button class="ghost" onclick="resetEditor()">清空编辑</button>
    </div>

    <div class="editor">
      <div class="field">
        <label for="editorLabel">账户名称</label>
        <input id="editorLabel" type="text" placeholder="例如 工商工资卡">
      </div>
      <div class="field bank">
        <label for="editorBank">银行</label>
        <select id="editorBank" onchange="fillTaskSelect()"></select>
      </div>
      <div class="field">
        <label for="editorLast4">卡号后四位</label>
        <input id="editorLast4" type="text" maxlength="4" placeholder="可选">
      </div>
      <div class="field task">
        <label for="editorTask">默认任务</label>
        <select id="editorTask"></select>
      </div>
      <button id="saveButton" onclick="saveEditorAccount()">添加账户</button>
      <button class="ghost" onclick="resetEditor()">取消</button>
    </div>

    <table>
      <thead>
        <tr>
          <th>账户</th>
          <th>银行</th>
          <th>后四位</th>
          <th>默认任务</th>
          <th style="text-align:right;">操作</th>
        </tr>
      </thead>
      <tbody id="accountRows"></tbody>
    </table>

    <div id="status">正在读取配置...</div>
  </div>
</body>
</html>
